# Copy this file to .env in the repository root before running Docker Compose.
# Replace every CHANGE_ME value with a locally generated random value.
POSTGRES_DB=agri
POSTGRES_USER=agri
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
AI_MODE=rules-only
POSTGRES_PORT=5432
REDIS_PORT=6379
MQTT_PORT=1883
API_PORT=8080
WEB_PORT=3000
