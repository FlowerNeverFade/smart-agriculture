# AgriLoop Docker deployment environment.
# Copy this file to .env at the release-package root and replace CHANGE_ME.
POSTGRES_DB=agri
POSTGRES_USER=agri
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
AI_MODE=rules-only
POSTGRES_PORT=5432
REDIS_PORT=6379
MQTT_PORT=1883
API_PORT=8080
WEB_PORT=3000
WEB_BIND_ADDRESS=127.0.0.1
