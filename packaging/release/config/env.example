# AgriLoop release environment. Copy to /srv/agriloop/shared/.env and
# replace every CHANGE_ME value before a production deployment.
APP_ROOT=/srv/agriloop
SPRING_PROFILES_ACTIVE=simulation
APP_MODE=simulation
SERVER_PORT=8080
SERVER_ADDRESS=127.0.0.1

DATABASE_NAME=agri
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/agri
DATABASE_USER=agri
DATABASE_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_DRIVER=org.postgresql.Driver
DATABASE_POOL_SIZE=8

REDIS_URL=redis://127.0.0.1:6379
MQTT_URL=tcp://127.0.0.1:1883
MQTT_CLIENT_ID=agriloop-api
MQTT_USERNAME=
MQTT_PASSWORD=

JWT_SECRET=CHANGE_ME_USE_AT_LEAST_32_RANDOM_BYTES
JWT_TTL_MINUTES=720
SYSTEM_ADMIN_AUTHORIZATION_CODE=
SEED_DATA=false
DEMO_SEED=true

AI_MODE=rules-only
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=Qwen3.8-27B
LLM_VISION_MODEL=Qwen3.8-27B
LLM_API_KEY=
LLM_TIMEOUT_MS=30000
LLM_MAX_TOKENS=768
LLM_ENABLE_THINKING=false
LLM_PRESERVE_THINKING=false
LLM_REASONING_EFFORT=none

COMMAND_MODE=virtual
FORECAST_MODE=deterministic
LEARNING_MODE=case-only
VALUE_MODE=simulation
TELEMETRY_STREAM=agri.telemetry
DEVICE_TIMEOUT_SECONDS=90
REAL_SOURCE_TIMEOUT_SECONDS=120
SSE_HEARTBEAT_SECONDS=15
MAX_IRRIGATION_SECONDS=900
MAX_LIGHTING_SECONDS=28800
DAILY_WATER_LIMIT_LITRES=5000
CROP_PACK_PATH=classpath:/crop-packs
SIMULATOR_CONTROL_ENABLED=true
SIMULATOR_AUTO_START=true
SIMULATION_CONFIG_PATH=/srv/agriloop/shared/data/plot-simulation.json
ATTACHMENT_DIR=/srv/agriloop/shared/attachments
SUPERVISOR_CONFIG=/etc/supervisor/supervisord.conf
SIMULATOR_PROGRAM=agriloop-simulator
MANAGEMENT_HEALTH_REDIS_ENABLED=true

MARKET_PRICE_ENABLED=true
MARKET_PRICE_BASE_URL=https://pfsc.agri.cn
MARKET_PRICE_PROVINCE_CODE=500000
MARKET_PRICE_PROVINCE_NAME=重庆市
MARKET_PRICE_PREFERRED_MARKET=重庆双福国际农贸城
MARKET_PRICE_AES_KEY='7s9K$pG2xQ8zR5mB7vA3sD9fH2jW40cV'
MARKET_PRICE_TIMEOUT_MS=8000
MARKET_PRICE_CACHE_MINUTES=30
