{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["cropCode", "version", "identity", "stages", "metrics", "rules", "knowledgeVersion", "prescriptionConstraints", "forecastProfile", "scenarios"],
  "properties": {
    "cropCode": {"type": "string", "minLength": 2},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "schemaVersion": {"type": "string"},
    "status": {"type": "string"},
    "ruleVersion": {"type": "string"},
    "knowledgeVersion": {"type": "string"},
    "identity": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string"},
        "variety": {"type": "string"},
        "region": {"type": "string"},
        "environment": {"type": "string"}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["code", "sequence", "target"],
        "properties": {
          "code": {"type": "string"},
          "sequence": {"type": "integer"},
          "label": {"type": "string"},
          "target": {"type": "object"},
          "riskFocus": {"type": "array"},
          "taskTemplates": {"type": "array"},
          "rules": {"type": "array"},
          "knowledgeRef": {"type": "string"}
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "object", "required": ["code", "availability"]}
    },
    "rules": {"type": "array", "minItems": 1},
    "healthProfile": {"type": "object"},
    "prescriptionConstraints": {"type": "object", "required": ["maxDurationSeconds", "cooldownMinutes"]},
    "forecastProfile": {"type": "object", "required": ["algorithm", "horizonsMinutes"]},
    "coordinationProfile": {"type": "object"},
    "knowledge": {"type": "object"},
    "scenarios": {"type": "object", "minProperties": 5},
    "testCases": {"type": "array"}
  },
  "additionalProperties": true
}
