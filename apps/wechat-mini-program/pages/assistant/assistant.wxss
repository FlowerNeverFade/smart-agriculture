.assistant-page { display: flex; flex-direction: column; min-height: 100vh; padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.assistant-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.assistant-heading { display: flex; align-items: center; min-width: 0; }
.assistant-mark { display: flex; align-items: center; justify-content: center; width: 62rpx; height: 62rpx; flex: 0 0 62rpx; border-radius: 18rpx; color: #fff; background: #21815a; font-size: 32rpx; }
.assistant-heading-copy { min-width: 0; margin-left: 14rpx; }
.assistant-title { color: #203a2c; font-size: 31rpx; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.assistant-subtitle { margin-top: 4rpx; color: #778a7e; font-size: 22rpx; }
.context-card { display: flex; align-items: center; justify-content: space-between; padding-top: 16rpx; padding-bottom: 16rpx; }
.context-label { color: #7b8a80; font-size: 23rpx; }
.context-value { color: #1c6d4b; font-size: 25rpx; font-weight: 600; }
.picker-arrow { margin-left: 8rpx; color: #6d8175; font-size: 30rpx; }
.conversation-scroll { width: 100%; margin: 2rpx 0 14rpx; white-space: nowrap; }
.conversation-row { display: inline-flex; align-items: stretch; gap: 10rpx; }
.new-conversation, .conversation-button { flex: 0 0 auto; min-height: 60rpx; padding: 0 18rpx; border: 1rpx solid #dbe8de; color: #397354 !important; background: #eef7f0 !important; font-size: 22rpx; line-height: 58rpx; }
.conversation-button { display: flex; flex-direction: column; justify-content: center; min-width: 190rpx; padding: 6rpx 16rpx; line-height: 1.2; text-align: left; }
.conversation-button.active { border-color: #65a17b; color: #1b6847 !important; background: #dff1e4 !important; }
.conversation-title { max-width: 250rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.conversation-meta { margin-top: 4rpx; color: #8a9a90; font-size: 19rpx; }
.message-scroll { flex: 1; min-height: 440rpx; max-height: 900rpx; padding: 4rpx 2rpx 14rpx; }
.message-loading { padding: 90rpx 0; }
.empty-chat { padding: 72rpx 20rpx 44rpx; text-align: center; }
.empty-greeting { color: #274534; font-size: 34rpx; font-weight: 700; }
.empty-copy { margin: 14rpx auto 30rpx; max-width: 620rpx; color: #718378; font-size: 24rpx; line-height: 1.6; }
.shortcut-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; max-width: 660rpx; margin: 0 auto; }
.shortcut-button { padding: 14rpx 12rpx; border: 1rpx solid #dceadf; border-radius: 12rpx; color: #397354 !important; background: #f6fbf6 !important; font-size: 23rpx; line-height: 1.35; }
.message-row { display: flex; margin: 12rpx 0; }
.message-user { justify-content: flex-end; }
.message-assistant { justify-content: flex-start; }
.message-bubble { max-width: 92%; padding: 18rpx 20rpx 14rpx; border-radius: 16rpx; background: #fff; box-shadow: 0 5rpx 18rpx rgba(37,74,54,.06); }
.message-user .message-bubble { color: #fff; background: #237b55; box-shadow: none; }
.message-meta { display: flex; align-items: center; justify-content: space-between; gap: 14rpx; margin-bottom: 10rpx; color: #4c735a; font-size: 20rpx; }
.message-user .message-meta { color: rgba(255,255,255,.82); }
.message-content { color: #324a3a; font-size: 25rpx; line-height: 1.6; word-break: break-word; }
.message-user .message-content { color: #fff; }
.image-note { margin-top: 8rpx; color: #799084; font-size: 21rpx; }
.message-user .image-note { color: rgba(255,255,255,.8); }
.facts-block, .recommendations-block { margin-top: 18rpx; padding-top: 14rpx; border-top: 1rpx solid #edf2ed; }
.sub-block-title { color: #41634d; font-size: 22rpx; font-weight: 700; }
.facts-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8rpx; margin-top: 10rpx; }
.fact-item { padding: 9rpx 10rpx; border-radius: 9rpx; background: #f5f9f5; }
.fact-label, .fact-value { display: block; }
.fact-label { color: #809087; font-size: 19rpx; }
.fact-value { margin-top: 3rpx; color: #315a40; font-size: 22rpx; font-weight: 600; }
.recommendation-row { display: flex; align-items: flex-start; gap: 7rpx; margin-top: 8rpx; color: #587160; font-size: 22rpx; line-height: 1.45; }
.recommendation-dot { color: #2b855d; font-size: 28rpx; line-height: 1; }
.action-card { margin-top: 18rpx; padding: 14rpx; border: 1rpx solid #e3eadf; border-radius: 12rpx; background: #f8fbf7; }
.action-head { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.action-summary { margin-top: 10rpx; color: #31543d; font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.action-argument { margin-top: 6rpx; color: #6d7f73; font-size: 22rpx; line-height: 1.45; }
.action-buttons { display: flex; gap: 10rpx; margin-top: 14rpx; }
.action-button { flex: 1; font-size: 22rpx; line-height: 58rpx; }
.action-error { margin-top: 8rpx; color: #ae4e43; font-size: 21rpx; }
.details-toggle { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; padding-top: 12rpx; border-top: 1rpx solid #edf2ed; color: #397354; font-size: 21rpx; }
.details-block { margin-top: 10rpx; padding: 10rpx; border-radius: 10rpx; background: #f7faf7; }
.evidence-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; padding: 9rpx 0; border-bottom: 1rpx solid #e8eee8; color: #567061; font-size: 21rpx; }
.evidence-row:last-child { border-bottom: 0; }
.evidence-main { min-width: 0; display: flex; flex-direction: column; gap: 3rpx; }
.evidence-main .tiny { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.trace-row { margin-top: 8rpx; color: #8a978d; font-size: 19rpx; word-break: break-all; }
.message-time { margin-top: 10rpx; color: #9aa69d; font-size: 19rpx; text-align: right; }
.message-user .message-time { color: rgba(255,255,255,.72); }
.typing-row { display: flex; align-items: center; gap: 10rpx; padding: 10rpx 18rpx; color: #75877a; font-size: 22rpx; }
.typing-dot { width: 14rpx; height: 14rpx; border-radius: 50%; background: #54a174; animation: pulse 1.1s ease-in-out infinite; }
@keyframes pulse { 0%, 100% { opacity: .35; } 50% { opacity: 1; } }
.assistant-error { margin: 6rpx 0; padding: 12rpx 14rpx; border-radius: 10rpx; color: #a34a3f; background: #fff4f1; font-size: 22rpx; line-height: 1.45; }
.composer { margin: 6rpx 0 0; padding: 14rpx; }
.image-scroll { width: 100%; margin-bottom: 10rpx; white-space: nowrap; }
.image-row { display: inline-flex; gap: 10rpx; }
.image-item { position: relative; width: 116rpx; height: 116rpx; flex: 0 0 116rpx; overflow: hidden; border-radius: 10rpx; background: #edf3ee; }
.image-item image { width: 100%; height: 100%; }
.image-remove { position: absolute; top: 4rpx; right: 4rpx; width: 30rpx; height: 30rpx; border-radius: 50%; color: #fff; background: rgba(0,0,0,.55); font-size: 25rpx; line-height: 28rpx; text-align: center; }
.image-size { position: absolute; right: 0; bottom: 0; left: 0; padding: 4rpx; color: #fff; background: rgba(0,0,0,.45); font-size: 17rpx; text-align: center; }
.composer-input { width: 100%; min-height: 76rpx; max-height: 220rpx; padding: 12rpx 14rpx; border: 1rpx solid #dce7df; border-radius: 12rpx; color: #263c30; background: #f9fbf9; font-size: 25rpx; line-height: 1.5; }
.composer-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 12rpx; }
.composer-left { display: flex; align-items: center; min-width: 0; gap: 10rpx; }
.icon-button { display: inline-flex; align-items: center; gap: 5rpx; padding: 0 12rpx; color: #397354 !important; background: #eef7f0 !important; font-size: 22rpx; line-height: 54rpx; }
.icon-button:first-letter { font-size: 30rpx; }
.composer-hint { color: #89968d; font-size: 19rpx; white-space: nowrap; }
.send-button { min-width: 132rpx; font-size: 24rpx; line-height: 58rpx; }
.placeholder { color: #a2afa6; }

@media (max-width: 380px) {
  .assistant-title { font-size: 28rpx; }
  .message-bubble { max-width: 96%; }
  .composer-hint { display: none; }
  .shortcut-button { font-size: 21rpx; }
}
